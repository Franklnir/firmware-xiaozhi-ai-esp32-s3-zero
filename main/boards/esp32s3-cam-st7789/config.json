{
    "type": "esp32s3-cam-st7789",
    "target": "esp32s3",
    "builds": [
        {
            "name": "esp32s3-cam-st7789-240x280",
            "build_options": {
                "camera_hmirror": false,
                "camera_vflip": true
            },
            "sdkconfig_append": [
                "CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y",
                "CONFIG_SPIRAM_MODE_OCT=y",
                "CONFIG_SPIRAM_SPEED_80M=y",
                "CONFIG_BT_ENABLED=y",
                "CONFIG_BT_BLUEDROID_ENABLED=y",
                "CONFIG_BT_ALLOCATION_FROM_SPIRAM_FIRST=y",
                "CONFIG_BT_BLE_DYNAMIC_ENV_MEMORY=y",
                "CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y",
                "CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y",
                "CONFIG_BT_BLE_50_FEATURES_SUPPORTED=n",
                "CONFIG_LANGUAGE_EN_US=y",
                "CONFIG_ESP_BROWNOUT_DET=n",
                "CONFIG_LV_FONT_MONTSERRAT_24=y",
                "CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=128",
                "CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768",
                "CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n",
                "CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n",
                "CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=n",
                "CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8",
                "CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=16",
                "CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16",
                "CONFIG_MBEDTLS_HARDWARE_AES=y",
                "CONFIG_BT_ACL_CONNECTIONS=2",
                "CONFIG_BT_CTRL_BLE_MAX_ACT=3"
            ]
        }
    ]
}
